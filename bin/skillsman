#!/usr/bin/env bash
set -euo pipefail

# Resolve installed symlinks so module and scenario paths do not depend on cwd.
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="${source_dir}/${source_path}" ;;
  esac
done
script_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
command -v node >/dev/null 2>&1 || { echo 'skillsman: Node.js >=22.20.0 is required' >&2; exit 1; }
exec node "${script_dir}/../lib/skillsman/project.cjs" "$@"
